{
  "name": "ryze-challenge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "storybook": "storybook dev -p 6007 --exact-port",
    "build-storybook": "storybook build",
    "test": "node --test scripts/website-address.test.mjs scripts/links-assets-and-copy.test.mjs scripts/ui-guardrails.test.mjs",
    "test:smoke": "npm run build -- --webpack && node --test scripts/browser-smoke.test.mjs",
    "test:all": "npm test && npm run test:smoke && npm run typecheck && npm run lint && npm run build-storybook",
    "test:links:live": "node scripts/links-live.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.7",
    "@storybook/nextjs-vite": "10.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "storybook": "10.6.7",
    "typescript": "^5"
  }
}
